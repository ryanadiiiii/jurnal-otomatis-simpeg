# ============================================
# SIMPEG Jurnal Harian Otomatis - Konfigurasi
# ============================================
# Salin file ini menjadi .env dan isi dengan data Anda.
# JANGAN commit file .env ke Git!

# --- Kredensial SIMPEG ---
SIMPEG_NIP=nip_anda_di_sini
SIMPEG_PASSWORD=password_anda_di_sini

# --- Telegram Notifikasi ---
# Cara mendapatkan:
# 1. Buka Telegram, cari @BotFather
# 2. Ketik /newbot, ikuti instruksi, catat TOKEN yang diberikan
# 3. Buka bot yang baru dibuat, kirim pesan apa saja
# 4. Buka: https://api.telegram.org/bot<TOKEN>/getUpdates
# 5. Cari "chat":{"id": 123456789} — itu CHAT_ID Anda
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp Notifikasi (Fonnte) ---
# Daftar di fonnte.com, hubungkan device, copy token API
FONNTE_TOKEN=
FONNTE_TARGET=

# --- Mode ---
# True = tidak submit (untuk testing), False = submit sungguhan
DRY_RUN=False

# --- Koordinat Kantor (untuk Absensi Online Jumat) ---
OFFICE_LATITUDE=-8.5925
OFFICE_LONGITUDE=116.0947

